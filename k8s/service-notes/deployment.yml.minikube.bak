apiVersion: apps/v1
kind: Deployment
metadata:
  name: service-notes-deployment
  namespace: smartschool
spec:
  replicas: 1
  selector:
    matchLabels:
      app: service-notes
  template:
    metadata:
      labels:
        app: service-notes
    spec:
      containers:
        - name: service-notes-container
          image: service-notes:latest
          imagePullPolicy: Never
          ports:
            - containerPort: 8002
          env:
            # 🟦 Variables de base
            - name: RABBITMQ_HOST
              value: "rabbitmq-service"
            - name: DB_HOST
              value: "postgres"
            - name: DB_PORT
              value: "5432"
            - name: DB_USER
              value: "postgres"
            - name: DB_PASSWORD
              value: "root"
            - name: DB_NAME
              value: "smartschool_db3"
            
            # 🟩 Port du service
            - name: PORT
              value: "8002"
            
            # 🟪 Variables Eureka
            - name: POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            
            - name: HOSTNAME
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            
            - name: EUREKA_HOST
              value: "registry-service"
            - name: EUREKA_PORT
              value: "8761"