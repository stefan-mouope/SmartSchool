apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend-service-deployment
  namespace: smartschool
spec:
  replicas: 1
  selector:
    matchLabels:
      app: frontend-service
  template:
    metadata:
      labels:
        app: frontend-service
    spec:
      containers:
      - name: frontend-service-container
        image: frontend-service:latest
        imagePullPolicy: Never
        ports:
        - containerPort: 8082
