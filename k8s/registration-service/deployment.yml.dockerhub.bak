apiVersion: apps/v1
kind: Deployment
metadata:
  name: registration-service-deployment
  namespace: smartschool
spec:
  replicas: 1
  selector:
    matchLabels:
      app: registration-service
  template:
    metadata:
      labels:
        app: registration-service
    spec:
      containers:
        - name: registration-service-container
          image: sandjonyves/registration-service:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 3000
          env:
            # 🟦 Variables de base
            - name: RABBITMQ_HOST
              value: "rabbitmq-service:5672"
            - name: DB_HOST
              value: "postgres"
            - name: DB_PORT
              value: "5432"
            - name: DB_USER
              value: "postgres"
            - name: DB_PASSWORD
              value: "root"
            - name: DB_NAME
              value: "smartschool_db2"
            
            # 🟩 Port interne du service Node
            - name: PORT
              value: "3000"
            
            # 🟪 Variables Eureka - CORRIGÉES
            # POD_IP contient l'IP du pod (ex: 10.244.0.123)
            - name: POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            
            # HOSTNAME contient aussi l'IP (pour compatibilité)
            - name: HOSTNAME
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            
            # POD_NAME contient le nom du pod (pour logging)
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            
            # Configuration Eureka
            - name: EUREKA_HOST
              value: "registry-service"
            - name: EUREKA_PORT
              value: "8761"